# Discord webhook for new matching listings & price-drop alerts
DISCORD_WEBHOOK_URL=

# Optional: Free-tier RapidAPI key for StreetEasy ("NYC Real Estate API" / streeteasy-api)
RAPIDAPI_KEY=
RAPIDAPI_STREETEASY_HOST=streeteasy-api.p.rapidapi.com

# Optional: Free-tier RentCast API key (50 free calls/month at rentcast.io)
RENTCAST_API_KEY=

# Optional: Free saved-search email ingestion via IMAP (e.g., Gmail App Password)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
